# Logto 基本設定
LOGTO_BASE_URL=https://your-logto-domain.com
LOGTO_ISSUER=https://your-logto-domain.com/oidc
LOGTO_TENANT_ID=default

# M2M Application（管理 API 用）
LOGTO_CLIENT_ID=your-m2m-client-id
LOGTO_CLIENT_SECRET=your-m2m-client-secret

# Management API indicator（self-hosted 固定為此值）
LOGTO_API_INDICATOR=https://default.logto.app/api

# Web Application（Experience API flow 用，需開啟 offline_access）
LOGTO_WEB_CLIENT_ID=your-web-client-id
LOGTO_WEB_CLIENT_SECRET=your-web-client-secret
LOGTO_WEB_REDIRECT_URI=http://localhost:3000/callback

# 你的 API Resource indicator（在 Logto Console 建立）
LOGTO_API_RESOURCE=https://api.your-app.com

PORT=3000
